# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# React frontend (used when DEBUG=False)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT token lifetimes (optional)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Email (console backend for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SQL Server connection
DB_NAME=blinkit_db
DB_HOST=localhost
# Leave empty for default instance (Windows). Set only if SQL Server uses a fixed port (e.g. 1433).
DB_PORT=

# Windows Authentication (default on local SQL Server)
DB_TRUSTED_CONNECTION=yes

# SQL Server Authentication — set DB_TRUSTED_CONNECTION=no and fill these:
# DB_TRUSTED_CONNECTION=no
# DB_USER=sa
# DB_PASSWORD=your_password

# ODBC driver (must be installed on the machine)
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=TrustServerCertificate=yes
