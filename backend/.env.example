# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# React frontend (used when DEBUG=False)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT token lifetimes (optional)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Email (console backend for local dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# PostgreSQL (local dev — or use DATABASE_URL instead)
DB_NAME=blinkit_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DATABASE_SSL=false

# Production (Neon on Render) — paste full connection string:
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DATABASE_SSL=true

# Production CORS (Render) — exact Vercel URL and/or regex for preview deploys:
# CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
# CORS_ALLOWED_ORIGIN_REGEXES=^https://[\w.-]+\.vercel\.app$

# Optional — enables Cloudinary for product images (required on Render production)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
